#!/bin/sh
# The first thing on the screen while the system starts: the logo
# (src/unseenet/logo.py, half blocks the console font has), or the name alone.
exec > /dev/tty1 2>&1
printf '\033[2J\033[H\033[?25l\n\n'
/opt/unseenet/bin/python -m unseenet.logo 2>/dev/null || printf '\033[92m        U N S E E N E T\033[0m\n'
printf '\n        Starting ...  (Alt+F3 shows the details)\n'
